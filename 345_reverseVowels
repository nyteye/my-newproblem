class Solution:
    def reverseVowels(self, s: str) -> str:
        # Convert string to list because Python strings are immutable
        s_list = list(s)
        
        # Define pointers
        left, right = 0, len(s) - 1
        
        # Use a set for O(1) constant time lookups
        vowels = set("aeiouAEIOU")
        
        while left < right:
            # Move left pointer forward until it finds a vowel
            while left < right and s_list[left] not in vowels:
                left += 1
            
            # Move right pointer backward until it finds a vowel
            while left < right and s_list[right] not in vowels:
                right -= 1
            
            # Swap the vowels found at left and right
            s_list[left], s_list[right] = s_list[right], s_list[left]
            
            # Move pointers inward to continue the search
            left += 1
            right -= 1
            
        # Join the list back into a string and return
        return "".join(s_list)

# --- Driver Code to Test the Solution ---
if __name__ == "__main__":
    solution = Solution()
    
    # Test Case 1
    input_str1 = "IceCreAm"
    result1 = solution.reverseVowels(input_str1)
    print(f"Input:  {input_str1}")
    print(f"Output: {result1}")  # Expected: "AceCreIm"
    print("-" * 20)

